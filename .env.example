# demo, emulator o firebase
PUBLIC_BACKEND=demo
PUBLIC_EMULATOR_HOST=127.0.0.1

# Configurazione pubblica dell'app Web Firebase
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_APP_CHECK_KEY=

# Origine canonica, per esempio https://www.tuosito.it
SITE_URL=

PUBLIC_FIREBASE_AUTH_DOMAIN=
# Indirizzo della privacy policy, se configurato
PRIVACY_URL=/privacy/
