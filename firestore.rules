rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Autorizzazioni esistenti per le recensioni.
    match /recensioni/{document=**} {
      allow read, write: if true;
    }

    // Invio del form pubblico, anche senza autenticazione.
    match /Contatti/{contactId} {
      function validContact() {
        let data = request.resource.data;
        let fields = ['name', 'surname', 'email', 'phone',
                      'education', 'message', 'timestamp'];
        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields)
          && data.name is string && data.name.size() > 0
          && data.surname is string && data.surname.size() > 0
          && data.email is string && data.email.size() > 0
          && data.phone is string && data.phone.matches('[0-9]{10,15}')
          && data.education is string
          && data.education in ['elementari', 'medie', 'superiori', 'universita', 'altro']
          && data.message is string && data.message.size() > 0
          && data.timestamp is timestamp;
      }

      allow create: if validContact();
    }

    // Accesso completo per gli utenti autenticati.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
